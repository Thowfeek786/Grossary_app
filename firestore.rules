rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users Collection & User Subcollections (addresses, favorites, cart, etc.)
    match /users/{userId} {
      allow read, write: if isSignedIn();

      match /addresses/{addressId} {
        allow read, write: if isSignedIn();
      }

      match /favorites/{favId} {
        allow read, write: if isSignedIn();
      }

      match /{subcollection}/{docId} {
        allow read, write: if isSignedIn();
      }
    }

    // Products Collection & Product Subcollections (reviews)
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();

      match /reviews/{reviewId} {
        allow read: if true;
        allow write: if isSignedIn();
      }

      match /{subcollection}/{docId} {
        allow read: if true;
        allow write: if isSignedIn();
      }
    }

    // Reviews Top-Level Collection
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Categories Collection
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Banners Collection
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Store Settings & Platform Settings Collection
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /store_settings/{settingId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Coupons Collection
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Wallets & History Collection
    match /wallets/{userId} {
      allow read, write: if isSignedIn();

      match /history/{txnId} {
        allow read, write: if isSignedIn();
      }

      match /{subcollection}/{docId} {
        allow read, write: if isSignedIn();
      }
    }

    // Orders Collection & Order Messages Subcollection
    match /orders/{orderId} {
      allow read, write: if isSignedIn();

      match /messages/{msgId} {
        allow read, write: if isSignedIn();
      }

      match /{subcollection}/{docId} {
        allow read, write: if isSignedIn();
      }
    }

    // Driver Live Telemetry Locations
    match /delivery_locations/{partnerId} {
      allow read, write: if isSignedIn();
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read, write: if isSignedIn();
    }

    // Support Tickets Collection
    match /support_tickets/{ticketId} {
      allow read, write: if isSignedIn();
    }

    // Support Chats (Chat Management)
    match /support_chats/{chatId} {
      allow read, write: if isSignedIn();

      match /messages/{msgId} {
        allow read, write: if isSignedIn();
      }

      match /{subcollection}/{docId} {
        allow read, write: if isSignedIn();
      }
    }

    // Payments Collection
    match /payments/{paymentId} {
      allow read, write: if isSignedIn();
    }

    // Refunds Collection
    match /refunds/{refundId} {
      allow read, write: if isSignedIn();
    }

    // Payout Requests Collection (Delivery Partners & Dealers)
    match /payout_requests/{payoutId} {
      allow read, write: if isSignedIn();
    }

    match /dealer_payouts/{payoutId} {
      allow read, write: if isSignedIn();
    }

    // Flash Sale Collection (both flash_sale and flash_sales)
    match /flash_sale/{saleId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /flash_sales/{saleId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // FCM Queue (Cloud functions processor)
    match /fcm_send_queue/{docId} {
      allow read, write: if isSignedIn();
    }

    // Water Can Module Collections (Can Exchanges, Deposits, & Return Ledgers)
    match /can_transactions/{transactionId} {
      allow read, write: if isSignedIn();
    }

    match /water_can_summaries/{summaryId} {
      allow read, write: if isSignedIn();
    }

    match /water_assets/{assetId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /water_subscriptions/{subId} {
      allow read, write: if isSignedIn();
    }

    match /water_quality_logs/{logId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /platform_settings/{settingId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}

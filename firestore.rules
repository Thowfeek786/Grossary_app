rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && (
        request.auth.token.role == role || 
        getUserData().role == role
      );
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isDealer() {
      return hasRole('dealer');
    }

    function isDeliveryPartner() {
      return hasRole('delivery_partner');
    }

    // Users Collection & User Subcollections (addresses, favorites, cart, etc.)
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();

      match /addresses/{addressId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /favorites/{favId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /{subcollection}/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Products Collection & Product Subcollections (reviews)
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || isDealer();

      match /reviews/{reviewId} {
        allow read: if true;
        allow write: if isSignedIn();
      }

      match /{subcollection}/{docId} {
        allow read: if true;
        allow write: if isSignedIn();
      }
    }

    // Categories Collection
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Banners Collection
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Store Settings & Platform Settings Collection
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() || isDealer();
    }

    match /store_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() || isDealer();
    }

    // Coupons Collection
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Wallets & History Collection
    match /wallets/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();

      match /history/{txnId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) || isAdmin();
      }

      match /{subcollection}/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) || isAdmin();
      }
    }

    // Orders Collection & Order Messages Subcollection
    match /orders/{orderId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.dealerId == request.auth.uid ||
        resource.data.deliveryPartnerId == request.auth.uid ||
        isDeliveryPartner() ||
        isAdmin()
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.dealerId == request.auth.uid ||
        resource.data.deliveryPartnerId == request.auth.uid ||
        isDeliveryPartner() ||
        isAdmin()
      );
      allow delete: if isAdmin();

      match /messages/{msgId} {
        allow read, write: if isSignedIn();
      }
    }

    // Driver Live Telemetry Locations
    match /delivery_locations/{partnerId} {
      allow read: if isSignedIn();
      allow write: if isOwner(partnerId) || isDeliveryPartner() || isAdmin();
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // Payments Collection
    match /payments/{paymentId} {
      allow read, write: if isSignedIn();
    }

    // Refunds Collection
    match /refunds/{refundId} {
      allow read, write: if isAdmin();
    }

    // FCM Queue (Cloud functions processor)
    match /fcm_send_queue/{docId} {
      allow read, write: if isSignedIn();
    }
  }
}
